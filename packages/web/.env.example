# Copia este archivo como .env.local (NUNCA lo subas a git)

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Nunca la secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Conexión directa a Postgres, solo para los scripts test-p*.mjs
# Supabase Dashboard → Connect → Connection string
DB_URL=

# Direccion del CommitmentRegistry y explorador de bloques.
# Sin estas, /verificar sigue funcionando pero no puede contrastar la raiz
# contra la cadena ni enlazar al explorador.
NEXT_PUBLIC_COMMITMENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_COMMITMENT_REGISTRY_EXPLORER=https://sepolia.basescan.org

# Solo servidor (sin NEXT_PUBLIC_). Cifra el numero de cuenta y la glosa de los
# movimientos bancarios. 64 hexadecimales: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde, lo ya cifrado no se puede leer.
BANK_DATA_KEY=

# Solo servidor. Para anclar la lista de proveedores y cerrar lotes (/api/org/batch).
# Secret key de Supabase (sb_secret_...): solo se usa para leer la sal de los pagos del lote.
SUPABASE_SERVICE_ROLE_KEY=
# Llave privada de una billetera autorizada como publicador en CommitmentRegistry.
PUBLISHER_PRIVATE_KEY=
# Opcional. Por defecto https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=
